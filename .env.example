VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# LLM API keys do NOT belong here or on Vercel (anything VITE_ is public).
# Set in Supabase → Project Settings → Edge Functions → Secrets, then
# redeploy: supabase functions deploy generate-worker
#
# DeepSeek (Admin → Generate → DeepSeek Flash / Pro):
#   DEEPSEEK_API_KEY=sk-...
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_FLASH_MODEL=deepseek-chat
#   DEEPSEEK_PRO_MODEL=deepseek-reasoner
#   DEEPSEEK_TIMEOUT_MS=180000
#
# NVIDIA NIM (free test + critic / binder vision):
#   NVIDIA_NIM_API_KEY=nvapi-...
#   NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
#   NVIDIA_NIM_FLASH_MODEL=nvidia/nemotron-3-super-120b-a12b
#   NVIDIA_NIM_PRO_MODEL=nvidia/nemotron-3-super-120b-a12b
#   NVIDIA_NIM_VISION_MODEL=minimaxai/minimax-m3
#   NVIDIA_NIM_TIMEOUT_MS=180000
