VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# NVIDIA NIM keys do NOT belong here or on Vercel (anything VITE_ is public).
# Set in Supabase → Project Settings → Edge Functions → Secrets:
#   NVIDIA_NIM_API_KEY=nvapi-...
#   NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
#   NVIDIA_NIM_FLASH_MODEL=nvidia/nemotron-3-super-120b-a12b
#   NVIDIA_NIM_PRO_MODEL=nvidia/nemotron-3-super-120b-a12b
#   NVIDIA_NIM_VISION_MODEL=minimaxai/minimax-m3
#   NVIDIA_NIM_TIMEOUT_MS=180000
